# Copy to .env for local development (npm run dev)
# Local Docker MySQL:
DATABASE_URL=mysql://root:changeme@localhost:3306/netflix
DB_SSL=false
# Cloud (e.g. Aiven) - use the Service URI from the dashboard and leave DB_SSL unset:
# DATABASE_URL=mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb
# DB_NAME=netflix
# Optional: real posters from TMDB (free key at themoviedb.org)
# TMDB_API_KEY=
